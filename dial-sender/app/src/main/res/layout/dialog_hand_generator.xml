<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/hand_builder_title"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Live Dial Preview & Hand Thumbnails -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@color/bg_elevated"
            android:padding="12dp"
            android:layout_marginBottom="12dp">

            <ImageView
                android:id="@+id/imgDialLivePreview"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:contentDescription="Live Dial Preview" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginStart="16dp">

                <TextView
                    android:id="@+id/txtHandDimensionsInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="H: 26×160\nM: 22×220\nS: 15×260"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:fontFamily="monospace" />
            </LinearLayout>
        </LinearLayout>

        <!-- Hand Tab Switcher -->
        <RadioGroup
            android:id="@+id/rgHandTabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <RadioButton
                android:id="@+id/rbHourHand"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:button="@null"
                android:gravity="center"
                android:padding="8dp"
                android:text="@string/hand_hour"
                android:textColor="@color/text_primary"
                android:checked="true"
                android:background="@drawable/tab_selector_bg" />

            <RadioButton
                android:id="@+id/rbMinuteHand"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:button="@null"
                android:gravity="center"
                android:padding="8dp"
                android:text="@string/hand_minute"
                android:textColor="@color/text_primary"
                android:background="@drawable/tab_selector_bg" />

            <RadioButton
                android:id="@+id/rbSecondHand"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:button="@null"
                android:gravity="center"
                android:padding="8dp"
                android:text="@string/hand_second"
                android:textColor="@color/text_primary"
                android:background="@drawable/tab_selector_bg" />
        </RadioGroup>

        <!-- Shape Selector Spinner -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hand_shape"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spinnerHandStyle"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@color/bg_elevated"
            android:layout_marginBottom="12dp" />

        <!-- Dimensions Grid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/dimensions"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/chkProportional"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hand_proportional"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:checked="true" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <!-- Width -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="4dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/hand_width"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp" />
                <EditText
                    android:id="@+id/edtHandWidth"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:inputType="number"
                    android:text="16"
                    android:textColor="@color/text_primary"
                    android:background="@color/bg_elevated"
                    android:padding="6dp"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Tip Length -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginHorizontal="4dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/hand_tip_length"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp" />
                <EditText
                    android:id="@+id/edtHandTipLen"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:inputType="number"
                    android:text="120"
                    android:textColor="@color/text_primary"
                    android:background="@color/bg_elevated"
                    android:padding="6dp"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Tail Length -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="4dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/hand_tail_length"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp" />
                <EditText
                    android:id="@+id/edtHandTailLen"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:inputType="number"
                    android:text="30"
                    android:textColor="@color/text_primary"
                    android:background="@color/bg_elevated"
                    android:padding="6dp"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Color Presets -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/color"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <View
                android:id="@+id/viewColorWhite"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="#FFFFFF"
                android:layout_marginEnd="8dp" />
            <View
                android:id="@+id/viewColorRed"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="#FF4444"
                android:layout_marginEnd="8dp" />
            <View
                android:id="@+id/viewColorYellow"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="#FFCC00"
                android:layout_marginEnd="8dp" />
            <View
                android:id="@+id/viewColorCyan"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="#22D3EE"
                android:layout_marginEnd="8dp" />
            <View
                android:id="@+id/viewColorOrange"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="#F97316"
                android:layout_marginEnd="8dp" />

            <EditText
                android:id="@+id/edtHexColor"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="#FFFFFF"
                android:textColor="@color/text_primary"
                android:background="@color/bg_elevated"
                android:padding="6dp"
                android:textSize="12sp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- Style Toggles -->
        <CheckBox
            android:id="@+id/chkOutline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hand_dark_outline"
            android:textColor="@color/text_primary"
            android:checked="true" />

        <CheckBox
            android:id="@+id/chkShadow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hand_drop_shadow"
            android:textColor="@color/text_primary"
            android:checked="true" />

        <CheckBox
            android:id="@+id/chkRounded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hand_rounded_caps"
            android:textColor="@color/text_primary"
            android:checked="true"
            android:layout_marginBottom="16dp" />

        <!-- Apply Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApplyHandSet"
            style="@style/ButtonSuccess"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/hand_apply_set"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
