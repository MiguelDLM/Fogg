<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/foggBgPrimary">

    <include layout="@layout/view_fogg_toolbar"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Appearance Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/appearance"
                android:textColor="?attr/foggAccent"
                android:textAppearance="?attr/foggTextRowValue"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginBottom="12dp"/>

            <!-- Theme -->
            <LinearLayout
                android:id="@+id/rowTheme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/foggCardBg"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/theme"
                    android:textColor="?attr/foggTextPrimary"
                    android:textAppearance="?attr/foggTextRowLabel"/>

                <TextView
                    android:id="@+id/txtThemeValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/theme_dark"
                    android:textColor="?attr/foggTextSecondary"
                    android:textAppearance="?attr/foggTextRowLabel"
                    android:drawableEnd="@drawable/ic_back"
                    android:drawablePadding="4dp"/>
            </LinearLayout>

            <!-- Language -->
            <LinearLayout
                android:id="@+id/rowLanguage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/foggCardBg"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/language"
                    android:textColor="?attr/foggTextPrimary"
                    android:textAppearance="?attr/foggTextRowLabel"/>

                <TextView
                    android:id="@+id/txtLangValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/lang_system"
                    android:textColor="?attr/foggTextSecondary"
                    android:textAppearance="?attr/foggTextRowLabel"
                    android:drawableEnd="@drawable/ic_back"
                    android:drawablePadding="4dp"/>
            </LinearLayout>

            <!-- About Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/about"
                android:textColor="?attr/foggAccent"
                android:textAppearance="?attr/foggTextRowValue"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginBottom="12dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/foggCardBg"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/version_label"
                    android:textColor="?attr/foggTextPrimary"
                    android:textAppearance="?attr/foggTextScreenTitle"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/about_desc"
                    android:textColor="?attr/foggTextSecondary"
                    android:textAppearance="?attr/foggTextRowValue"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/about_author"
                    android:textColor="?attr/foggTextMuted"
                    android:textAppearance="?attr/foggTextRowValue"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
