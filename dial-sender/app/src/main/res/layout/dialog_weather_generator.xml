<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/foggBgSurface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/weather_builder_title"
            android:textColor="?attr/foggTextPrimary"
            android:textAppearance="?attr/foggTextScreenTitle"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/weather_frames_hint"
            android:textColor="?attr/foggTextMuted"
            android:textAppearance="?attr/foggTextCaption"
            android:layout_marginBottom="10dp" />

        <!-- Live 12-icon Preview Grid -->
        <GridLayout
            android:id="@+id/gridWeatherIconsPreview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:columnCount="6"
            android:rowCount="2"
            android:background="?attr/foggBgElevated"
            android:padding="8dp"
            android:layout_marginBottom="12dp">

            <ImageView android:id="@+id/imgWeather0" android:layout_width="44dp" android:layout_height="44dp" android:layout_margin="2dp"/>
            <ImageView android:id="@+id/imgWeather1" android:layout_width="44dp" android:layout_height="44dp" android:layout_margin="2dp"/>
            <ImageView android:id="@+id/imgWeather2" android:layout_width="44dp" android:layout_height="44dp" android:layout_margin="2dp"/>
            <ImageView android:id="@+id/imgWeather3" android:layout_width="44dp" android:layout_height="44dp" android:layout_margin="2dp"/>
            <ImageView android:id="@+id/imgWeather4" android:layout_width="44dp" android:layout_height="44dp" android:layout_margin="2dp"/>
            <ImageView android:id="@+id/imgWeather5" android:layout_width="44dp" android:layout_height="44dp" android:layout_margin="2dp"/>
            <ImageView android:id="@+id/imgWeather6" android:layout_width="44dp" android:layout_height="44dp" android:layout_margin="2dp"/>
            <ImageView android:id="@+id/imgWeather7" android:layout_width="44dp" android:layout_height="44dp" android:layout_margin="2dp"/>
            <ImageView android:id="@+id/imgWeather8" android:layout_width="44dp" android:layout_height="44dp" android:layout_margin="2dp"/>
            <ImageView android:id="@+id/imgWeather9" android:layout_width="44dp" android:layout_height="44dp" android:layout_margin="2dp"/>
            <ImageView android:id="@+id/imgWeather10" android:layout_width="44dp" android:layout_height="44dp" android:layout_margin="2dp"/>
            <ImageView android:id="@+id/imgWeather11" android:layout_width="44dp" android:layout_height="44dp" android:layout_margin="2dp"/>
        </GridLayout>

        <!-- Icon style -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/weather_style"
            android:textColor="?attr/foggTextMuted"
            android:textAppearance="?attr/foggTextCaption" />

        <RadioGroup
            android:id="@+id/rgWeatherStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <RadioButton
                android:id="@+id/rbWeatherFilled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/weather_style_filled"
                android:textColor="?attr/foggTextPrimary"
                android:textAppearance="?attr/foggTextRowValue"
                android:layout_marginEnd="16dp" />

            <RadioButton
                android:id="@+id/rbWeatherOutline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/weather_style_outline"
                android:textColor="?attr/foggTextPrimary"
                android:textAppearance="?attr/foggTextRowValue" />
        </RadioGroup>

        <!-- Sun colour -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/weather_color_sun"
            android:textColor="?attr/foggTextMuted"
            android:textAppearance="?attr/foggTextCaption" />
        <LinearLayout
            android:id="@+id/paletteWeatherSun"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp" />

        <!-- Cloud colour -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/weather_color_cloud"
            android:textColor="?attr/foggTextMuted"
            android:textAppearance="?attr/foggTextCaption" />
        <LinearLayout
            android:id="@+id/paletteWeatherCloud"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp" />

        <!-- Rain colour -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/weather_color_rain"
            android:textColor="?attr/foggTextMuted"
            android:textAppearance="?attr/foggTextCaption" />
        <LinearLayout
            android:id="@+id/paletteWeatherRain"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp" />

        <!-- Stroke width -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/weather_stroke"
                android:textColor="?attr/foggTextMuted"
                android:textAppearance="?attr/foggTextCaption"
                android:layout_marginEnd="8dp" />

            <SeekBar
                android:id="@+id/seekWeatherStroke"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="8"
                android:progress="3"
                android:progressTint="?attr/foggAccent"
                android:thumbTint="?attr/foggAccent" />
        </LinearLayout>

        <!-- Dimensions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="6dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/width"
                    android:textColor="?attr/foggTextMuted"
                    android:textAppearance="?attr/foggTextCaption" />
                <EditText
                    android:id="@+id/edtWeatherWidth"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:inputType="number"
                    android:text="64"
                    android:textColor="?attr/foggTextPrimary"
                    android:background="?attr/foggBgElevated"
                    android:padding="6dp"
                    android:textAppearance="?attr/foggTextRowValue" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="6dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/height"
                    android:textColor="?attr/foggTextMuted"
                    android:textAppearance="?attr/foggTextCaption" />
                <EditText
                    android:id="@+id/edtWeatherHeight"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:inputType="number"
                    android:text="64"
                    android:textColor="?attr/foggTextPrimary"
                    android:background="?attr/foggBgElevated"
                    android:padding="6dp"
                    android:textAppearance="?attr/foggTextRowValue" />
            </LinearLayout>
        </LinearLayout>

        <!-- Apply Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApplyWeather"
            style="@style/ButtonSuccess"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/weather_apply"
            android:textAppearance="?attr/foggTextRowLabel" />

    </LinearLayout>
</ScrollView>
