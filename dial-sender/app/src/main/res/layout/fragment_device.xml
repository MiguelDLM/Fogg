<?xml version="1.0" encoding="utf-8"?>
<!--
  Device tab. Every row now leads with an icon and ends with either a value or
  a real chevron vector; the styles come from the theme, so density, radius and
  type change with the design language rather than being fixed here.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/foggBgPrimary"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout style="@style/Fogg.ScreenContent">

        <!-- ═══════════ Hero: bound device, link state, battery ═══════════ -->
        <LinearLayout style="?attr/foggCardStyle">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/imgWatch"
                    android:layout_width="86dp"
                    android:layout_height="86dp"
                    android:layout_marginEnd="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_watch_device"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/txtDeviceName"
                            style="@style/Fogg.CardTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:text="@string/device_default_name"/>

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginEnd="3dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_battery"
                            app:tint="?attr/foggAccent"/>

                        <TextView
                            android:id="@+id/txtBattery"
                            style="@style/Fogg.Caption"
                            android:textColor="?attr/foggAccent"
                            android:text=""/>
                    </LinearLayout>

                    <!-- Link state: coloured dot + label -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:layout_marginTop="6dp">

                        <View
                            android:id="@+id/statusIndicator"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/indicator_disconnected"/>

                        <TextView
                            android:id="@+id/txtStatus"
                            style="@style/Fogg.Caption"
                            android:textColor="?attr/foggDanger"
                            android:text="@string/disconnected"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtDeviceMac"
                        style="@style/Fogg.Caption"
                        android:layout_marginTop="4dp"
                        android:text=""/>

                    <LinearLayout
                        android:id="@+id/statsRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="6dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/txtRssi"
                            style="@style/Fogg.Caption"
                            android:text="FW:"/>

                        <TextView
                            android:id="@+id/txtFirmware"
                            style="@style/Fogg.Caption"
                            android:layout_marginStart="4dp"
                            android:textColor="?attr/foggAccent"
                            android:text="—"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Connection Buttons: Connect / Reconnect and QR Pair -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="18dp">

                <Button
                    android:id="@+id/btnConnect"
                    style="?attr/foggButtonPrimaryStyle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="@string/scan_connect"/>

                <Button
                    android:id="@+id/btnQrPair"
                    style="?attr/foggButtonGhostStyle"
                    android:layout_width="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:drawableStart="@drawable/ic_qr_code"
                    android:drawablePadding="8dp"
                    android:text="@string/pair_with_qr"/>
            </LinearLayout>
        </LinearLayout>

        <!-- ═══════════ Screen & watch faces ═══════════ -->
        <TextView
            style="?attr/foggSectionHeaderStyle"
            android:text="@string/dev_section_screen"/>

        <LinearLayout style="?attr/foggGroupStyle">

            <LinearLayout android:id="@+id/btnWatchFaces" style="?attr/foggRowStyle">
                <ImageView style="?attr/foggRowIconStyle" android:src="@drawable/ic_watchface"
                    android:contentDescription="@null"/>
                <TextView style="@style/Fogg.Row.Label" android:text="@string/dev_watchfaces"/>
                <ImageView style="@style/Fogg.Row.Chevron" android:contentDescription="@null"/>
            </LinearLayout>
            <View style="?attr/foggDividerStyle"/>

            <LinearLayout android:id="@+id/rowBacklight" style="?attr/foggRowStyle">
                <ImageView style="?attr/foggRowIconStyle" android:src="@drawable/ic_brightness"
                    android:contentDescription="@null" app:tint="?attr/foggCalories"/>
                <TextView style="@style/Fogg.Row.Label" android:text="@string/device_backlight_title"/>
                <TextView android:id="@+id/txtBacklight" style="@style/Fogg.Row.Value" android:text="5s"/>
            </LinearLayout>
            <View style="?attr/foggDividerStyle"/>

            <LinearLayout android:id="@+id/rowRaiseToWake" style="?attr/foggRowStyle">
                <ImageView style="?attr/foggRowIconStyle" android:src="@drawable/ic_raise_to_wake"
                    android:contentDescription="@null"/>
                <TextView style="@style/Fogg.Row.Label" android:text="@string/device_raise_to_wake"/>
                <TextView android:id="@+id/txtRaiseToWake" style="@style/Fogg.Row.Value" android:text="@string/state_off"/>
            </LinearLayout>
            <View style="?attr/foggDividerStyle"/>

            <LinearLayout android:id="@+id/rowStandby" style="?attr/foggRowStyle">
                <ImageView style="?attr/foggRowIconStyle" android:src="@drawable/ic_standby"
                    android:contentDescription="@null" app:tint="?attr/foggCalories"/>
                <LinearLayout style="@style/Fogg.Row.Column">
                    <TextView style="@style/Fogg.Row.Title" android:text="@string/dev_standby"/>
                    <TextView android:id="@+id/txtStandby" style="@style/Fogg.Row.Subtitle"
                        android:text="@string/state_off"/>
                </LinearLayout>
                <ImageView style="@style/Fogg.Row.Chevron" android:contentDescription="@null"/>
            </LinearLayout>
        </LinearLayout>

        <!-- ═══════════ Continuous health monitoring ═══════════ -->
        <TextView
            style="?attr/foggSectionHeaderStyle"
            android:text="@string/dev_section_health"/>

        <LinearLayout style="?attr/foggGroupStyle">

            <LinearLayout android:id="@+id/rowHrMonitoring" style="?attr/foggRowStyle">
                <ImageView style="?attr/foggRowIconStyle" android:src="@drawable/ic_metric_heart"
                    android:contentDescription="@null" app:tint="?attr/foggHeart"/>
                <LinearLayout style="@style/Fogg.Row.Column">
                    <TextView style="@style/Fogg.Row.Title" android:text="@string/dev_hr_monitoring"/>
                    <TextView android:id="@+id/txtHrMonitoring" style="@style/Fogg.Row.Subtitle"
                        android:text="@string/state_off"/>
                </LinearLayout>
                <ImageView style="@style/Fogg.Row.Chevron" android:contentDescription="@null"/>
            </LinearLayout>
            <View style="?attr/foggDividerStyle"/>

            <LinearLayout android:id="@+id/rowSpo2Monitoring" style="?attr/foggRowStyle">
                <ImageView style="?attr/foggRowIconStyle" android:src="@drawable/ic_metric_spo2"
                    android:contentDescription="@null" app:tint="?attr/foggSpo2"/>
                <LinearLayout style="@style/Fogg.Row.Column">
                    <TextView style="@style/Fogg.Row.Title" android:text="@string/dev_spo2_monitoring"/>
                    <TextView android:id="@+id/txtSpo2Monitoring" style="@style/Fogg.Row.Subtitle"
                        android:text="@string/state_off"/>
                </LinearLayout>
                <ImageView style="@style/Fogg.Row.Chevron" android:contentDescription="@null"/>
            </LinearLayout>
            <View style="?attr/foggDividerStyle"/>

            <LinearLayout android:id="@+id/rowSleepMonitoring" style="?attr/foggRowStyle">
                <ImageView style="?attr/foggRowIconStyle" android:src="@drawable/ic_metric_sleep"
                    android:contentDescription="@null" app:tint="?attr/foggSleep"/>
                <LinearLayout style="@style/Fogg.Row.Column">
                    <TextView style="@style/Fogg.Row.Title" android:text="@string/dev_sleep_monitoring"/>
                    <TextView android:id="@+id/txtSleepMonitoring" style="@style/Fogg.Row.Subtitle"
                        android:text="@string/state_off"/>
                </LinearLayout>
                <ImageView style="@style/Fogg.Row.Chevron" android:contentDescription="@null"/>
            </LinearLayout>
            <View style="?attr/foggDividerStyle"/>

            <LinearLayout android:id="@+id/rowSedentary" style="?attr/foggRowStyle">
                <ImageView style="?attr/foggRowIconStyle" android:src="@drawable/ic_sedentary"
                    android:contentDescription="@null" app:tint="?attr/foggStress"/>
                <LinearLayout style="@style/Fogg.Row.Column">
                    <TextView style="@style/Fogg.Row.Title" android:text="@string/dev_sedentary"/>
                    <TextView android:id="@+id/txtSedentary" style="@style/Fogg.Row.Subtitle"
                        android:text="@string/state_off"/>
                </LinearLayout>
                <ImageView style="@style/Fogg.Row.Chevron" android:contentDescription="@null"/>
            </LinearLayout>
            <View style="?attr/foggDividerStyle"/>

            <LinearLayout android:id="@+id/rowDrinkWater" style="?attr/foggRowStyle">
                <ImageView style="?attr/foggRowIconStyle" android:src="@drawable/ic_water"
                    android:contentDescription="@null" app:tint="?attr/foggDistance"/>
                <LinearLayout style="@style/Fogg.Row.Column">
                    <TextView style="@style/Fogg.Row.Title" android:text="@string/dev_drink_water"/>
                    <TextView android:id="@+id/txtDrinkWater" style="@style/Fogg.Row.Subtitle"
                        android:text="@string/state_off"/>
                </LinearLayout>
                <ImageView style="@style/Fogg.Row.Chevron" android:contentDescription="@null"/>
            </LinearLayout>
            <View style="?attr/foggDividerStyle"/>

            <LinearLayout android:id="@+id/rowTempMonitoring" style="?attr/foggRowStyle">
                <ImageView style="?attr/foggRowIconStyle" android:src="@drawable/ic_metric_pulse"
                    android:contentDescription="@null" app:tint="?attr/foggCalories"/>
                <LinearLayout style="@style/Fogg.Row.Column">
                    <TextView style="@style/Fogg.Row.Title" android:text="@string/dev_temp_monitoring"/>
                    <TextView android:id="@+id/txtTempMonitoring" style="@style/Fogg.Row.Subtitle"
                        android:text="@string/state_off"/>
                </LinearLayout>
                <ImageView style="@style/Fogg.Row.Chevron" android:contentDescription="@null"/>
            </LinearLayout>
            <View style="?attr/foggDividerStyle"/>

            <LinearLayout android:id="@+id/rowWash" style="?attr/foggRowStyle">
                <ImageView style="?attr/foggRowIconStyle" android:src="@drawable/ic_wash"
                    android:contentDescription="@null" app:tint="?attr/foggSpo2"/>
                <LinearLayout style="@style/Fogg.Row.Column">
                    <TextView style="@style/Fogg.Row.Title" android:text="@string/dev_wash"/>
                    <TextView android:id="@+id/txtWash" style="@style/Fogg.Row.Subtitle"
                        android:text="@string/state_off"/>
                </LinearLayout>
                <ImageView style="@style/Fogg.Row.Chevron" android:contentDescription="@null"/>
            </LinearLayout>
            <View style="?attr/foggDividerStyle"/>

            <LinearLayout android:id="@+id/rowHrWarning" style="?attr/foggRowStyle">
                <ImageView style="?attr/foggRowIconStyle" android:src="@drawable/ic_metric_heart"
                    android:contentDescription="@null" app:tint="?attr/foggHeart"/>
                <LinearLayout style="@style/Fogg.Row.Column">
                    <TextView style="@style/Fogg.Row.Title" android:text="@string/dev_hr_warning"/>
                    <TextView android:id="@+id/txtHrWarning" style="@style/Fogg.Row.Subtitle"
                        android:text="@string/state_off"/>
                </LinearLayout>
                <ImageView style="@style/Fogg.Row.Chevron" android:contentDescription="@null"/>
            </LinearLayout>
            <View style="?attr/foggDividerStyle"/>

            <LinearLayout android:id="@+id/rowFemaleCare" style="?attr/foggRowStyle">
                <ImageView style="?attr/foggRowIconStyle" android:src="@drawable/ic_female_care"
                    android:contentDescription="@null" app:tint="?attr/foggHeart"/>
                <LinearLayout style="@style/Fogg.Row.Column">
                    <TextView style="@style/Fogg.Row.Title" android:text="@string/dev_female_care"/>
                    <TextView android:id="@+id/txtFemaleCare" style="@style/Fogg.Row.Subtitle"
                        android:text="@string/state_off"/>
                </LinearLayout>
                <ImageView style="@style/Fogg.Row.Chevron" android:contentDescription="@null"/>
            </LinearLayout>
        </LinearLayout>

        <!-- ═══════════ Notifications & handy features ═══════════ -->
        <TextView
            style="?attr/foggSectionHeaderStyle"
            android:text="@string/dev_section_utils"/>

        <LinearLayout style="?attr/foggGroupStyle">

            <LinearLayout android:id="@+id/rowNotifications" style="?attr/foggRowStyle">
                <ImageView style="?attr/foggRowIconStyle" android:src="@drawable/ic_notifications"
                    android:contentDescription="@null"/>
                <TextView style="@style/Fogg.Row.Label" android:text="@string/dev_notifications"/>
                <ImageView style="@style/Fogg.Row.Chevron" android:contentDescription="@null"/>
            </LinearLayout>
            <View style="?attr/foggDividerStyle"/>

            <LinearLayout android:id="@+id/rowAlarms" style="?attr/foggRowStyle">
                <ImageView style="?attr/foggRowIconStyle" android:src="@drawable/ic_alarm"
                    android:contentDescription="@null"/>
                <TextView style="@style/Fogg.Row.Label" android:text="@string/dev_alarms"/>
                <ImageView style="@style/Fogg.Row.Chevron" android:contentDescription="@null"/>
            </LinearLayout>
            <View style="?attr/foggDividerStyle"/>

            <LinearLayout android:id="@+id/rowWorldClock" style="?attr/foggRowStyle">
                <ImageView style="?attr/foggRowIconStyle" android:src="@drawable/ic_world_clock"
                    android:contentDescription="@null" app:tint="?attr/foggDistance"/>
                <TextView style="@style/Fogg.Row.Label" android:text="@string/dev_world_clock"/>
                <ImageView style="@style/Fogg.Row.Chevron" android:contentDescription="@null"/>
            </LinearLayout>
            <View style="?attr/foggDividerStyle"/>

            <LinearLayout android:id="@+id/rowStock" style="?attr/foggRowStyle">
                <ImageView style="?attr/foggRowIconStyle" android:src="@drawable/ic_stock"
                    android:contentDescription="@null" app:tint="?attr/foggSteps"/>
                <TextView style="@style/Fogg.Row.Label" android:text="@string/dev_stock"/>
                <ImageView style="@style/Fogg.Row.Chevron" android:contentDescription="@null"/>
            </LinearLayout>
            <View style="?attr/foggDividerStyle"/>

            <LinearLayout android:id="@+id/rowCallControl" style="?attr/foggRowStyle">
                <ImageView style="?attr/foggRowIconStyle" android:src="@drawable/ic_call"
                    android:contentDescription="@null"/>
                <TextView style="@style/Fogg.Row.Label" android:text="@string/dev_call_control"/>
                <TextView android:id="@+id/txtCallControl" style="@style/Fogg.Row.Value" android:text="@string/state_off"/>
            </LinearLayout>
            <View style="?attr/foggDividerStyle"/>

            <LinearLayout android:id="@+id/rowFindWatch" style="?attr/foggRowStyle">
                <ImageView style="?attr/foggRowIconStyle" android:src="@drawable/ic_vibration"
                    android:contentDescription="@null"/>
                <TextView style="@style/Fogg.Row.Label" android:text="@string/dev_ring_watch"/>
                <TextView android:id="@+id/txtFindWatch" style="@style/Fogg.Row.Value" android:text="@string/find_watch_ring"/>
            </LinearLayout>
            <View style="?attr/foggDividerStyle"/>

            <LinearLayout android:id="@+id/btnCamera" style="?attr/foggRowStyle">
                <ImageView style="?attr/foggRowIconStyle" android:src="@drawable/ic_camera"
                    android:contentDescription="@null"/>
                <TextView style="@style/Fogg.Row.Label" android:text="@string/dev_camera"/>
                <ImageView style="@style/Fogg.Row.Chevron" android:contentDescription="@null"/>
            </LinearLayout>
            <View style="?attr/foggDividerStyle"/>

            <LinearLayout android:id="@+id/btnShakeCamera" style="?attr/foggRowStyle">
                <ImageView style="?attr/foggRowIconStyle" android:src="@drawable/ic_shake"
                    android:contentDescription="@null"/>
                <TextView style="@style/Fogg.Row.Label" android:text="@string/device_shake_camera"/>
                <ImageView style="@style/Fogg.Row.Chevron" android:contentDescription="@null"/>
            </LinearLayout>
            <View style="?attr/foggDividerStyle"/>

            <LinearLayout android:id="@+id/rowDnd" style="?attr/foggRowStyle">
                <ImageView style="?attr/foggRowIconStyle" android:src="@drawable/ic_dnd"
                    android:contentDescription="@null"/>
                <TextView style="@style/Fogg.Row.Label" android:text="@string/dev_dnd"/>
                <TextView android:id="@+id/txtDnd" style="@style/Fogg.Row.Value" android:text="@string/state_off"/>
            </LinearLayout>
            <View style="?attr/foggDividerStyle"/>

            <LinearLayout android:id="@+id/rowVibration" style="?attr/foggRowStyle">
                <ImageView style="?attr/foggRowIconStyle" android:src="@drawable/ic_settings"
                    android:contentDescription="@null" app:tint="?attr/foggCalories"/>
                <TextView style="@style/Fogg.Row.Label" android:text="@string/dev_vibration"/>
                <TextView android:id="@+id/txtVibration" style="@style/Fogg.Row.Value"
                    android:text="@string/state_off"/>
            </LinearLayout>
            <View style="?attr/foggDividerStyle"/>

            <LinearLayout android:id="@+id/rowUnits" style="?attr/foggRowStyle">
                <ImageView style="?attr/foggRowIconStyle" android:src="@drawable/ic_settings"
                    android:contentDescription="@null"/>
                <TextView style="@style/Fogg.Row.Label" android:text="@string/dev_units"/>
                <TextView android:id="@+id/txtUnits" style="@style/Fogg.Row.Value"
                    android:text="@string/units_metric"/>
            </LinearLayout>
            <View style="?attr/foggDividerStyle"/>

            <LinearLayout android:id="@+id/rowAntiLost" style="?attr/foggRowStyle">
                <ImageView style="?attr/foggRowIconStyle" android:src="@drawable/ic_bluetooth"
                    android:contentDescription="@null"/>
                <TextView style="@style/Fogg.Row.Label" android:text="@string/dev_antilost"/>
                <TextView android:id="@+id/txtAntiLost" style="@style/Fogg.Row.Value" android:text="@string/state_off"/>
            </LinearLayout>
        </LinearLayout>

        <!-- ═══════════ System & maintenance ═══════════ -->
        <TextView
            style="?attr/foggSectionHeaderStyle"
            android:text="@string/dev_section_system"/>

        <LinearLayout style="?attr/foggGroupStyle">

            <LinearLayout android:id="@+id/btnFirmware" style="?attr/foggRowStyle">
                <ImageView style="?attr/foggRowIconStyle" android:src="@drawable/ic_system_update"
                    android:contentDescription="@null"/>
                <TextView style="@style/Fogg.Row.Label" android:text="@string/device_fw_update_title"/>
                <TextView android:id="@+id/txtFirmwareRowValue" style="@style/Fogg.Row.Value" android:text="v1.0.0"/>
            </LinearLayout>
            <View style="?attr/foggDividerStyle"/>

            <LinearLayout android:id="@+id/btnAgps" style="?attr/foggRowStyle">
                <ImageView style="?attr/foggRowIconStyle" android:src="@drawable/ic_sync"
                    android:contentDescription="@null"/>
                <TextView style="@style/Fogg.Row.Label" android:text="@string/dev_agps"/>
                <ImageView style="@style/Fogg.Row.Chevron" android:contentDescription="@null"/>
            </LinearLayout>
            <View style="?attr/foggDividerStyle"/>

            <LinearLayout android:id="@+id/rowSos" style="?attr/foggRowStyle">
                <ImageView style="?attr/foggRowIconStyle" android:src="@drawable/ic_settings"
                    android:contentDescription="@null" app:tint="?attr/foggDanger"/>
                <TextView style="@style/Fogg.Row.Label" android:text="@string/dev_sos"/>
                <TextView android:id="@+id/txtSos" style="@style/Fogg.Row.Value"
                    android:text="@string/state_off"/>
            </LinearLayout>
            <View style="?attr/foggDividerStyle"/>

            <LinearLayout android:id="@+id/rowWatchPassword" style="?attr/foggRowStyle">
                <ImageView style="?attr/foggRowIconStyle" android:src="@drawable/ic_settings"
                    android:contentDescription="@null"/>
                <TextView style="@style/Fogg.Row.Label" android:text="@string/dev_watch_password"/>
                <TextView android:id="@+id/txtWatchPassword" style="@style/Fogg.Row.Value"
                    android:text="@string/state_off"/>
            </LinearLayout>
            <View style="?attr/foggDividerStyle"/>

            <LinearLayout android:id="@+id/rowGameTime" style="?attr/foggRowStyle">
                <ImageView style="?attr/foggRowIconStyle" android:src="@drawable/ic_settings"
                    android:contentDescription="@null"/>
                <TextView style="@style/Fogg.Row.Label" android:text="@string/dev_game_time"/>
                <TextView android:id="@+id/txtGameTime" style="@style/Fogg.Row.Value"
                    android:text="@string/state_off"/>
            </LinearLayout>
            <View style="?attr/foggDividerStyle"/>

            <LinearLayout android:id="@+id/rowShutdown" style="?attr/foggRowStyle">
                <ImageView style="?attr/foggRowIconStyle" android:src="@drawable/ic_standby"
                    android:contentDescription="@null" app:tint="?attr/foggDanger"/>
                <TextView style="@style/Fogg.Row.Label"
                    android:textColor="?attr/foggDanger"
                    android:text="@string/dev_shutdown"/>
            </LinearLayout>
            <View style="?attr/foggDividerStyle"/>

            <LinearLayout android:id="@+id/btnDisconnect" style="?attr/foggRowStyle">
                <ImageView style="?attr/foggRowIconStyle" android:src="@drawable/ic_link_off"
                    android:contentDescription="@null" app:tint="?attr/foggDanger"/>
                <TextView style="@style/Fogg.Row.Label"
                    android:textColor="?attr/foggDanger"
                    android:text="@string/dev_disconnect"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
