<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/foggBgPrimary"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header Row with Back button and Title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_back"
                android:contentDescription="@string/back"
                app:tint="#FFFFFF" />

            <TextView
                android:id="@+id/txtSportTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/sport_detail_title"
                android:textColor="#FFFFFF"
                android:textAppearance="?attr/foggTextScreenTitle" />

            <ImageButton
                android:id="@+id/btnDeleteSession"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_delete"
                android:contentDescription="@string/sport_delete_title"
                app:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/btnShare"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_share"
                android:contentDescription="@string/sport_share_route"
                app:tint="#FFFFFF" />
        </LinearLayout>

        <!-- Stats Card (CoFit/STF Dark premium style) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/foggCardBg"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/txtSessionDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="?attr/foggTextSecondary"
                android:textAppearance="?attr/foggTextRowValue"
                android:layout_marginBottom="16dp"/>

            <!-- Main Stats Grid -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="3"
                android:alignmentMode="alignMargins"
                android:columnOrderPreserved="false"
                android:useDefaultMargins="true">

                <!-- Duration -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:padding="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sport_duration"
                        android:textColor="?attr/foggTextSecondary"
                        android:textAppearance="?attr/foggTextCaption"/>
                    <TextView
                        android:id="@+id/txtDuration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00:00:00"
                        android:textColor="?attr/foggAccent"
                        android:textAppearance="?attr/foggTextScreenTitle"/>
                </LinearLayout>

                <!-- Distance -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:padding="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/metric_distance"
                        android:textColor="?attr/foggTextSecondary"
                        android:textAppearance="?attr/foggTextCaption"/>
                    <TextView
                        android:id="@+id/txtDistance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.00 km"
                        android:textColor="?attr/foggAccent"
                        android:textAppearance="?attr/foggTextScreenTitle"/>
                </LinearLayout>

                <!-- Calories -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:padding="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/metric_calories"
                        android:textColor="?attr/foggTextSecondary"
                        android:textAppearance="?attr/foggTextCaption"/>
                    <TextView
                        android:id="@+id/txtCalories"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 kcal"
                        android:textColor="?attr/foggDanger"
                        android:textAppearance="?attr/foggTextScreenTitle"/>
                </LinearLayout>

                <!-- Ritmo/Pace -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:padding="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sport_avg_pace"
                        android:textColor="?attr/foggTextSecondary"
                        android:textAppearance="?attr/foggTextCaption"/>
                    <TextView
                        android:id="@+id/txtPace"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--'--"
                        android:textColor="?attr/foggAccent"
                        android:textAppearance="?attr/foggTextScreenTitle"/>
                </LinearLayout>

                <!-- Heart Rate Avg -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:padding="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sport_avg_hr"
                        android:textColor="?attr/foggTextSecondary"
                        android:textAppearance="?attr/foggTextCaption"/>
                    <TextView
                        android:id="@+id/txtAvgHr"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textColor="?attr/foggDanger"
                        android:textAppearance="?attr/foggTextScreenTitle"/>
                </LinearLayout>

                <!-- Elevation gain -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:padding="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sport_elevation_gain"
                        android:textColor="?attr/foggTextSecondary"
                        android:textAppearance="?attr/foggTextCaption"/>
                    <TextView
                        android:id="@+id/txtElevation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-- m"
                        android:textColor="#F59E0B"
                        android:textAppearance="?attr/foggTextScreenTitle"/>
                </LinearLayout>

            </GridLayout>
        </LinearLayout>

        <!-- Route: hidden when the session has no GPS trace -->
        <LinearLayout
            android:id="@+id/sectionMap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/detail_route"
                android:textColor="?attr/foggTextSecondary"
                android:textAppearance="?attr/foggTextRowValue"
                android:textStyle="bold"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="8dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="300dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                android:layout_marginBottom="18dp"
                android:backgroundTint="?attr/foggBgElevated">

                <WebView
                    android:id="@+id/mapWebView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <TextView
            android:id="@+id/txtNoSensorData"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/foggCardBg"
            android:padding="16dp"
            android:layout_marginBottom="18dp"
            android:text="@string/detail_no_sensor_data"
            android:textColor="?attr/foggTextMuted"
            android:textAppearance="?attr/foggTextRowValue"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txtChartsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/detail_charts"
            android:textColor="?attr/foggTextSecondary"
            android:textAppearance="?attr/foggTextRowValue"
            android:textStyle="bold"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="8dp" />

        <!-- Heart Rate Chart Card -->
        <LinearLayout
            android:id="@+id/sectionHeartRate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/foggCardBg"
            android:orientation="vertical"
            android:padding="14dp"
            android:layout_marginBottom="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sport_chart_hr"
                android:textColor="#FFFFFF"
                android:textAppearance="?attr/foggTextRowLabel"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"/>
            <com.github.mikephil.charting.charts.LineChart
                android:id="@+id/chartHeartRate"
                android:layout_width="match_parent"
                android:layout_height="180dp" />
        </LinearLayout>

        <!-- Elevation Chart Card -->
        <LinearLayout
            android:id="@+id/sectionElevation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/foggCardBg"
            android:orientation="vertical"
            android:padding="14dp"
            android:layout_marginBottom="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sport_chart_elevation"
                android:textColor="#FFFFFF"
                android:textAppearance="?attr/foggTextRowLabel"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"/>
            <com.github.mikephil.charting.charts.LineChart
                android:id="@+id/chartElevation"
                android:layout_width="match_parent"
                android:layout_height="180dp" />
        </LinearLayout>

        <!-- Speed Chart Card -->
        <LinearLayout
            android:id="@+id/sectionSpeed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/foggCardBg"
            android:orientation="vertical"
            android:padding="14dp"
            android:layout_marginBottom="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sport_chart_speed"
                android:textColor="#FFFFFF"
                android:textAppearance="?attr/foggTextRowLabel"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"/>
            <com.github.mikephil.charting.charts.LineChart
                android:id="@+id/chartSpeed"
                android:layout_width="match_parent"
                android:layout_height="180dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
