<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/foggBgPrimary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include layout="@layout/view_fogg_toolbar"/>

        <TextView
            android:id="@+id/tvAlarmsHint"
            style="@style/Fogg.Body"
            android:paddingStart="?attr/foggScreenPadding"
            android:paddingEnd="?attr/foggScreenPadding"
            android:paddingTop="14dp"
            android:paddingBottom="6dp"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAlarms"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="?attr/foggScreenPadding"
            android:paddingEnd="?attr/foggScreenPadding"
            android:paddingBottom="88dp"
            android:clipToPadding="false"
            android:scrollbars="none"/>

        <!-- Empty state: icon over a line of copy, not a bare sentence. -->
        <LinearLayout
            android:id="@+id/tvAlarmsEmpty"
            style="@style/Fogg.EmptyState"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:visibility="gone">

            <ImageView
                style="@style/Fogg.EmptyState.Icon"
                android:contentDescription="@null"
                android:src="@drawable/ic_alarm"/>

            <TextView
                style="@style/Fogg.Body"
                android:gravity="center"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:text="@string/alarms_empty"/>
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddAlarm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:contentDescription="@string/alarm_add"
        android:src="@drawable/ic_add"
        app:backgroundTint="?attr/foggAccent"
        app:tint="?attr/foggOnAccent"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
