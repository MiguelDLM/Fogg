<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/foggBgPrimary">

    <include layout="@layout/view_fogg_toolbar"/>

    <!-- Shown until notification access is granted. -->
    <LinearLayout
        android:id="@+id/bannerPermission"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/foggWarning"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="?attr/foggScreenPadding"
        android:paddingEnd="8dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="12dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_info"
            app:tint="#FFFFFF"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/notif_perm_not_granted"
            android:textColor="#FFFFFF"/>

        <Button
            android:id="@+id/btnGrantPermission"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/notif_grant_perm"
            android:textColor="#FFFFFF"/>
    </LinearLayout>

    <TextView
        style="@style/Fogg.Body"
        android:paddingStart="?attr/foggScreenPadding"
        android:paddingEnd="?attr/foggScreenPadding"
        android:paddingTop="14dp"
        android:paddingBottom="6dp"
        android:text="@string/notif_apps_forwarded"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvApps"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="?attr/foggScreenPadding"
        android:paddingEnd="?attr/foggScreenPadding"
        android:paddingBottom="24dp"
        android:clipToPadding="false"
        android:scrollbars="none"/>

</LinearLayout>
