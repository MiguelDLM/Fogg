<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/connect_builder_title"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/connect_frames_hint"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:layout_marginBottom="10dp" />

        <!-- Live preview: off / on -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@color/bg_elevated"
            android:padding="12dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="28dp">
                <ImageView
                    android:id="@+id/imgConnect0"
                    android:layout_width="60dp"
                    android:layout_height="60dp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/connect_state_off"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">
                <ImageView
                    android:id="@+id/imgConnect1"
                    android:layout_width="60dp"
                    android:layout_height="60dp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/connect_state_on"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Style -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/connect_style"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />
        <Spinner
            android:id="@+id/spinnerConnectStyle"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="10dp" />

        <!-- Connected colour -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/connect_color_on"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />
        <LinearLayout
            android:id="@+id/paletteConnectOn"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp" />

        <!-- Disconnected colour -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/connect_color_off"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />
        <LinearLayout
            android:id="@+id/paletteConnectOff"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp" />

        <CheckBox
            android:id="@+id/chkConnectSlash"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/connect_slash"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <CheckBox
            android:id="@+id/chkConnectBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/connect_badge"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:layout_marginBottom="6dp" />

        <!-- Stroke -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">
            <TextView
                android:layout_width="76dp"
                android:layout_height="wrap_content"
                android:text="@string/weather_stroke"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
            <SeekBar
                android:id="@+id/seekConnectStroke"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="10"
                android:progress="4"
                android:progressTint="@color/accent_primary"
                android:thumbTint="@color/accent_primary" />
        </LinearLayout>

        <!-- Dimensions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="6dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/width"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />
                <EditText
                    android:id="@+id/edtConnectWidth"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:inputType="number"
                    android:text="48"
                    android:textColor="@color/text_primary"
                    android:background="@color/bg_elevated"
                    android:padding="6dp"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="6dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/height"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />
                <EditText
                    android:id="@+id/edtConnectHeight"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:inputType="number"
                    android:text="48"
                    android:textColor="@color/text_primary"
                    android:background="@color/bg_elevated"
                    android:padding="6dp"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApplyConnect"
            style="@style/ButtonSuccess"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/connect_apply"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
