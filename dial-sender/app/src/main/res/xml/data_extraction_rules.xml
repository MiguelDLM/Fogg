<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (dataExtractionRules). Same rule as backup_rules.xml, applied to
  both cloud backup and device-to-device transfer: the health series and the
  watch binding never leave the phone.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="dial_sender_prefs.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="dial_sender_prefs.xml"/>
    </device-transfer>
</data-extraction-rules>
