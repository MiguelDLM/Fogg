<?xml version="1.0" encoding="utf-8"?>
<!--
  Type scale, one set per design family. This is a large part of what makes the
  themes feel structurally different rather than merely recoloured: the HUD
  family is condensed and wide-tracked, Organic is round and calm, Bold is
  heavy and oversized, Glass is medium-weight, and Editorial is light with
  display-sized numerals.
-->
<resources>

    <!-- ═════════════════════ Shared base ═════════════════════ -->
    <style name="FoggText" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textColor">?attr/foggTextPrimary</item>
    </style>

    <!-- ═════════════════════ HUD — Midnight ═════════════════════ -->
    <style name="FoggText.Hud.ScreenTitle" parent="FoggText">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
    </style>
    <style name="FoggText.Hud.SectionHeader" parent="FoggText">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textColor">?attr/foggAccent</item>
    </style>
    <style name="FoggText.Hud.CardTitle" parent="FoggText">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textAllCaps">true</item>
    </style>
    <style name="FoggText.Hud.MetricValue" parent="FoggText">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">30sp</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>
    <style name="FoggText.Hud.MetricInline" parent="FoggText">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">20sp</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="FoggText.Hud.MetricUnit" parent="FoggText">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textColor">?attr/foggTextSecondary</item>
    </style>
    <style name="FoggText.Hud.Body" parent="FoggText">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?attr/foggTextSecondary</item>
    </style>
    <style name="FoggText.Hud.RowLabel" parent="FoggText">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0.01</item>
