<?xml version="1.0" encoding="utf-8"?>
<!--
  Themes are assembled in three layers, which is what keeps the system modular:

    Theme.Fogg.Base      — component-style bindings shared by every theme
      └ Theme.Fogg.Family.*  — the *design language*: shape scale, density
                               scale, type scale, component variants
          └ Theme.Fogg.<name> — the *palette* only

  A new colour scheme is ~28 lines and inherits a full design language; a new
  design language is one Family style and every palette can adopt it.
-->
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ════════════════════════ Layer 1: shared ════════════════════════ -->
    <style name="Theme.Fogg.Base" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>

        <!-- Semantic states are palette-independent. -->
        <item name="foggSuccess">@color/fogg_success</item>
        <item name="foggWarning">@color/fogg_warning</item>
        <item name="foggDanger">@color/fogg_danger</item>

        <!-- Component backgrounds. Families override the ones they change. -->
        <item name="foggCardBg">@drawable/bg_fogg_card</item>
        <item name="foggCardBgAccent">@drawable/bg_fogg_card_accent</item>
        <item name="foggGroupBg">@drawable/bg_fogg_group</item>
        <item name="foggRowBg">@drawable/bg_fogg_row</item>
        <item name="foggChipBg">@drawable/bg_fogg_chip</item>
        <item name="foggChipBgActive">@drawable/bg_fogg_chip_active</item>
        <item name="foggInputBg">@drawable/bg_fogg_input</item>
        <item name="foggBadgeBg">@drawable/bg_fogg_badge</item>
        <item name="foggButtonPrimaryBg">@drawable/bg_fogg_button_primary</item>
        <item name="foggBottomNavBg">@drawable/bg_fogg_bottom_nav</item>
        <item name="foggProgressBg">@drawable/bg_fogg_progress</item>
        <item name="foggToolbarBg">@drawable/bg_fogg_toolbar</item>

        <!-- Component styles. -->
        <item name="foggCardStyle">@style/Fogg.Card</item>
        <item name="foggGroupStyle">@style/Fogg.Group</item>
        <item name="foggRowStyle">@style/Fogg.Row</item>
        <item name="foggRowIconStyle">@style/Fogg.Row.Icon</item>
        <item name="foggDividerStyle">@style/Fogg.Divider</item>
        <item name="foggSectionHeaderStyle">@style/Fogg.SectionHeader</item>
        <item name="foggScreenTitleStyle">@style/Fogg.ScreenTitle</item>
        <item name="foggToolbarStyle">@style/Fogg.Toolbar</item>
        <item name="foggButtonPrimaryStyle">@style/Fogg.Button.Primary</item>
        <item name="foggButtonGhostStyle">@style/Fogg.Button.Ghost</item>

        <!-- Alert dialogs inherit the palette and the corner radius. -->
        <item name="materialAlertDialogTheme">@style/Fogg.Dialog.Material</item>
        <item name="alertDialogTheme">@style/Fogg.Dialog</item>
    </style>

    <!-- ═════════════════ Layer 2: design languages ═════════════════ -->

