    <!--
      Editorial — no cards at all. Content sits on the page, grouped by
      full-bleed hairlines, with spacious rows and display-weight numerals.
      This is the family that most visibly proves a theme is more than a
      recolour.
    -->
    <style name="Theme.Fogg.Family.Editorial" parent="Theme.Fogg.Base">
        <item name="foggDesignFamily">editorial</item>

        <item name="foggRadiusCard">0dp</item>
        <item name="foggRadiusSmall">0dp</item>
        <item name="foggRadiusChip">2dp</item>
        <item name="foggRadiusButton">2dp</item>
        <item name="foggRadiusBadge">0dp</item>
        <item name="foggStroke">0dp</item>

        <item name="foggScreenPadding">24dp</item>
        <item name="foggCardPadding">18dp</item>
        <item name="foggCardGap">8dp</item>
        <item name="foggSectionGap">34dp</item>
        <item name="foggRowPaddingV">20dp</item>
        <item name="foggRowPaddingH">0dp</item>
        <item name="foggIconSize">20dp</item>
        <item name="foggBadgeSize">20dp</item>

        <!-- Structural swaps, not just tokens. -->
        <item name="foggCardBg">@drawable/bg_fogg_card_editorial</item>
        <item name="foggCardBgAccent">@drawable/bg_fogg_card_editorial</item>
        <item name="foggGroupBg">@drawable/bg_fogg_group_editorial</item>
        <item name="foggDividerStyle">@style/Fogg.Divider.Full</item>
        <!-- Bare glyphs instead of tinted badges. -->
        <item name="foggRowIconStyle">@style/Fogg.Row.Icon.Bare</item>
        <item name="foggSectionHeaderStyle">@style/Fogg.SectionHeader.Editorial</item>

        <item name="foggTextScreenTitle">@style/FoggText.Editorial.ScreenTitle</item>
        <item name="foggTextSectionHeader">@style/FoggText.Editorial.SectionHeader</item>
        <item name="foggTextCardTitle">@style/FoggText.Editorial.CardTitle</item>
        <item name="foggTextMetricValue">@style/FoggText.Editorial.MetricValue</item>
        <item name="foggTextMetricUnit">@style/FoggText.Editorial.MetricUnit</item>
        <item name="foggTextMetricInline">@style/FoggText.Editorial.MetricInline</item>
        <item name="foggTextBody">@style/FoggText.Editorial.Body</item>
        <item name="foggTextRowLabel">@style/FoggText.Editorial.RowLabel</item>
        <item name="foggTextRowValue">@style/FoggText.Editorial.RowValue</item>
        <item name="foggTextCaption">@style/FoggText.Editorial.Caption</item>
