        <item name="foggStroke">1dp</item>

        <item name="foggScreenPadding">16dp</item>
        <item name="foggCardPadding">16dp</item>
        <item name="foggCardGap">10dp</item>
        <item name="foggSectionGap">20dp</item>
        <item name="foggRowPaddingV">12dp</item>
        <item name="foggRowPaddingH">14dp</item>
        <item name="foggIconSize">20dp</item>
        <item name="foggBadgeSize">34dp</item>

        <item name="foggTextScreenTitle">@style/FoggText.Hud.ScreenTitle</item>
        <item name="foggTextSectionHeader">@style/FoggText.Hud.SectionHeader</item>
        <item name="foggTextCardTitle">@style/FoggText.Hud.CardTitle</item>
        <item name="foggTextMetricValue">@style/FoggText.Hud.MetricValue</item>
        <item name="foggTextMetricUnit">@style/FoggText.Hud.MetricUnit</item>
        <item name="foggTextMetricInline">@style/FoggText.Hud.MetricInline</item>
        <item name="foggTextBody">@style/FoggText.Hud.Body</item>
        <item name="foggTextRowLabel">@style/FoggText.Hud.RowLabel</item>
        <item name="foggTextRowValue">@style/FoggText.Hud.RowValue</item>
        <item name="foggTextCaption">@style/FoggText.Hud.Caption</item>
        <item name="foggTextButton">@style/FoggText.Hud.Button</item>
    </style>

