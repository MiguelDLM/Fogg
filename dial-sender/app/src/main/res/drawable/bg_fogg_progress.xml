<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="?attr/foggRadiusChip"/>
            <solid android:color="?attr/foggGaugeTrack"/>
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="?attr/foggRadiusChip"/>
                <gradient
                    android:startColor="?attr/foggAccent"
                    android:endColor="?attr/foggAccentSecondary"
                    android:angle="0"/>
            </shape>
        </clip>
    </item>
</layer-list>
