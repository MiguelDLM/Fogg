<?xml version="1.0" encoding="utf-8"?>
<!-- Window background for AppCompat alert dialogs, inset the way the platform
     dialog background is so the shadow has room. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="16dp"
    android:insetRight="16dp"
    android:insetTop="16dp"
    android:insetBottom="16dp">
    <shape android:shape="rectangle">
        <solid android:color="?attr/foggDialogSurface"/>
        <stroke android:width="?attr/foggStroke" android:color="?attr/foggCardBorder"/>
        <corners android:radius="?attr/foggRadiusCard"/>
    </shape>
</inset>
