<?xml version="1.0" encoding="utf-8"?>
<!-- Card that carries the accent: used for hero/primary blocks. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:startColor="?attr/foggAccentGlow"
        android:endColor="?attr/foggBgCardEnd"
        android:angle="315"/>
    <stroke android:width="?attr/foggStroke" android:color="?attr/foggCardBorder"/>
    <corners android:radius="?attr/foggRadiusCard"/>
</shape>
