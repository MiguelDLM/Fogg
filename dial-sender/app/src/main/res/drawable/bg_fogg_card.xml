<?xml version="1.0" encoding="utf-8"?>
<!-- Generic card. Radius, stroke and fill all come from the active theme, so
     one file covers every design family that draws a filled card. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:startColor="?attr/foggBgCard"
        android:endColor="?attr/foggBgCardEnd"
        android:angle="315"/>
    <stroke android:width="?attr/foggStroke" android:color="?attr/foggCardBorder"/>
    <corners android:radius="?attr/foggRadiusCard"/>
</shape>
