<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/foggBgSurface"/>
        </shape>
    </item>
    <!-- Hairline that reads as a top edge without a heavy 1dp frame. -->
    <item android:bottom="-2dp" android:left="-2dp" android:right="-2dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent"/>
            <stroke android:width="1dp" android:color="?attr/foggDivider"/>
        </shape>
    </item>
</layer-list>
